<Window x:Class="FuryEqualize.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FuryEqualize" Height="780" Width="860" MinHeight="700" MinWidth="760"
        WindowStartupLocation="CenterScreen" Icon="Assets/App.ico"
        Background="#0B0F14" Foreground="#E8E8E8" ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#131A22"/>
        <SolidColorBrush x:Key="CardBg" Color="#1A232E"/>
        <SolidColorBrush x:Key="Accent" Color="#22D3EE"/>
        <SolidColorBrush x:Key="Accent2" Color="#7C3AED"/>
        <SolidColorBrush x:Key="Muted" Color="#8B98A5"/>
        <SolidColorBrush x:Key="Danger" Color="#EF4444"/>
        <SolidColorBrush x:Key="Success" Color="#22C55E"/>
        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22D3EE" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#06121A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5,26,5"/>
            <Setter Property="BorderBrush" Value="#2A3B4C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="8" SnapsToDevicePixels="True"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#182330"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                            <Path x:Name="Arrow"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Data="M 0,0 L 4,4 L 8,0 Z"
                                  Fill="{StaticResource Muted}"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   StaysOpen="False"
                                   VerticalOffset="4">
                                <Border x:Name="DropDownBorder"
                                        Background="#121A23"
                                        BorderBrush="#2A3B4C"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="2">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#D7E0E8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Margin="4,1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22303F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B2A38"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#1E2B3A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SectionSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#66757F"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
        </Style>
        <Style x:Key="ParamBlock" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#22303F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#AAB8C4"/>
        </Style>
        <Style x:Key="ParamValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18" MaxWidth="1200">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" CornerRadius="14" Padding="18,16" Margin="0,0,0,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#141C26" Offset="0"/>
                    <GradientStop Color="#18222F" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="12" Width="46" Height="46" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#22D3EE" Offset="0"/>
                                <GradientStop Color="#7C3AED" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="FE" FontSize="18" FontWeight="Black" Foreground="#06121A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FURY" FontSize="24" FontWeight="Black" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="EQUALIZE" FontSize="24" FontWeight="Light" Margin="8,0,0,0" Foreground="White"/>
                            <Border Background="{StaticResource AccentGrad}" CornerRadius="4" Padding="8,2" Margin="12,0,0,2" VerticalAlignment="Center">
                                <TextBlock Text="PRO" FontSize="8" FontWeight="Bold" Foreground="#06121A"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Controle total do som • Supressão • Footstep focus" FontSize="10" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="#1C2733" CornerRadius="20" Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#4A5864"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StartStopLabel}" FontSize="12" Foreground="#E8E8E8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== MASTER VOLUME ===== -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" BorderBrush="{StaticResource Accent}" BorderThickness="1.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MASTER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="{Binding MasterVolumeDb, StringFormat='{}{0:F1} dB'}" FontSize="20" FontWeight="Black" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                    <Slider Minimum="-24" Maximum="24" Value="{Binding MasterVolumeDb}"
                            TickFrequency="3" Height="20"/>
                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="-24dB" FontSize="8" Foreground="#556270" HorizontalAlignment="Left"/>
                        <TextBlock Text="0dB" FontSize="8" Foreground="#556270" HorizontalAlignment="Center"/>
                        <TextBlock Text="+24dB" FontSize="8" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource AccentGrad}" CornerRadius="10" Padding="16,10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MasterVolumePercent, StringFormat='{}{0}%'}" FontSize="16" FontWeight="Black" Foreground="#06121A" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== DEVICE CONFIG + PRESET ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <!-- Devices -->
            <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Text="ÁUDIO" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Dispositivos e latência" Style="{StaticResource SectionSub}"/>
                    <TextBlock Text="Captura (loopback)" FontSize="10" Foreground="{StaticResource Muted}"/>
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" Width="280" HorizontalAlignment="Left"/>
                    <TextBlock Text="Render (fone / VB-Cable)" FontSize="10" Foreground="{StaticResource Muted}"/>
                    <ComboBox ItemsSource="{Binding RenderDevices}" SelectedItem="{Binding SelectedRenderDevice}" DisplayMemberPath="Name" Width="280" HorizontalAlignment="Left"/>
                    <TextBlock Text="Buffer (latência)" FontSize="10" Foreground="{StaticResource Muted}"/>
                    <ComboBox ItemsSource="{Binding BufferSizes}" SelectedItem="{Binding SelectedBuffer}" Width="280" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding StartStopLabel}" Click="OnToggleEngine" Width="150"/>
                        <Button Content="↻ Atualizar" Click="OnRefresh" Background="{StaticResource PanelBg}" Foreground="#E8E8E8" Width="90"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Preset -->
            <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="6,0,0,12">
                <StackPanel>
                    <TextBlock Text="PRESET" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Selecione o perfil de processamento" Style="{StaticResource SectionSub}"/>
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Width="280" HorizontalAlignment="Left"/>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="8" Padding="12" Margin="0,8,0,0" BorderBrush="#2A3B4C" BorderThickness="1">
                        <TextBlock Text="{Binding SelectedPreset.Description}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/>
                    </Border>
                    <WrapPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource ParamBlock}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Threshold" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Text="{Binding ThresholdDb, StringFormat='  {0:F1}dB'}" Style="{StaticResource ParamValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ParamBlock}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ratio" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Text="{Binding Ratio, StringFormat='  {0:F1}:1'}" Style="{StaticResource ParamValue}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== PARAMETERS (Sniper) ===== -->
        <Border Grid.Row="3" Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="PARÂMETROS REAIS" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Ajuste fino do compressor e supressão em tempo real" Style="{StaticResource SectionSub}"/>
                <UniformGrid Columns="2">
                    <!-- Threshold -->
                    <Border Style="{StaticResource ParamBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Threshold" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ThresholdDb, StringFormat='{}{0:F1} dB'}" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider Minimum="-60" Maximum="0" Value="{Binding ThresholdDb, Mode=TwoWay}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Ratio -->
                    <Border Style="{StaticResource ParamBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Ratio" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Ratio, StringFormat='{}{0:F1}:1'}" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="20" Value="{Binding Ratio, Mode=TwoWay}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Attack -->
                    <Border Style="{StaticResource ParamBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Attack" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding AttackMs, StringFormat='{}{0:F2} ms'}" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider Minimum="0.1" Maximum="100" Value="{Binding AttackMs, Mode=TwoWay}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Release -->
                    <Border Style="{StaticResource ParamBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Release" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ReleaseMs, StringFormat='{}{0:F0} ms'}" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider Minimum="10" Maximum="500" Value="{Binding ReleaseMs, Mode=TwoWay}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Makeup -->
                    <Border Style="{StaticResource ParamBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Makeup Gain" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding MakeupDb, StringFormat='{}{0:F1} dB'}" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider Minimum="-12" Maximum="24" Value="{Binding MakeupDb, Mode=TwoWay}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- LFE Gate -->
                    <Border Style="{StaticResource ParamBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="LFE Gate" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding LfeGate, StringFormat='{}{0:F1} dB'}" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider Minimum="-80" Maximum="0" Value="{Binding LfeGate, Mode=TwoWay}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- FrontLock Eng -->
                    <Border Style="{StaticResource ParamBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="FrontLock Eng" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FrontLockEng, StringFormat='{}{0:F1}'}" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="20" Value="{Binding FrontLockEng, Mode=TwoWay}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- FrontLock Rel -->
                    <Border Style="{StaticResource ParamBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="FrontLock Rel" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FrontLockRel, StringFormat='{}{0:F1}'}" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="20" Value="{Binding FrontLockRel, Mode=TwoWay}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- FcCrack -->
                    <Border Style="{StaticResource ParamBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="FC Crack" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FcCrack, StringFormat='{}{0:F2} dB'}" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider Minimum="-20" Maximum="5" Value="{Binding FcCrack, Mode=TwoWay}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Tier2Centered -->
                    <Border Style="{StaticResource ParamBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Tier2 Centered" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Tier2Centered, StringFormat='{}{0:F2} dB'}" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider Minimum="-10" Maximum="5" Value="{Binding Tier2Centered, Mode=TwoWay}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- ===== MIXER POR PRESET ===== -->
        <Border Grid.Row="4" Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="MIXER POR PRÉ-SET" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Ganhos de cada canal para o preset ativo" Style="{StaticResource SectionSub}"/>
                <ItemsControl ItemsSource="{Binding Channels71}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ShortName}" FontSize="10" Foreground="#AAB8C4"
                                           HorizontalAlignment="Center" FontWeight="Bold"/>
                                <Slider Orientation="Vertical" Height="90" Minimum="0" Maximum="2"
                                        Value="{Binding GainLinear, Mode=TwoWay}"
                                        TickFrequency="0.5" TickPlacement="BottomRight" Margin="0,6,0,4" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding GainPercent, StringFormat='{}{0}%'}" FontSize="9"
                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding GainDb, StringFormat='{}{0:F1}dB'}" FontSize="8"
                                           Foreground="#66757F" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                    <Border Background="{StaticResource PanelBg}" CornerRadius="8" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LFE:" FontSize="10" Foreground="#AAB8C4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider Minimum="-24" Maximum="12" Value="{Binding LfeGainDb}" Width="140" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding LfeGainDb, StringFormat='{}{0:F1} dB'}" FontSize="10" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Content="RESET PRE-SET" Command="{Binding ResetChannels71Command}"
                            Background="{StaticResource PanelBg}" Foreground="{StaticResource Accent}" Margin="12,0,0,0" Padding="14,6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== TELEMETRIA ===== -->
        <Border Grid.Row="5" Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="TELEMETRIA" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Monitoramento em tempo real" Style="{StaticResource SectionSub}"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Input" Grid.Row="0" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Row="0" Grid.Column="1" Height="12" Minimum="-60" Maximum="0"
                                 Value="{Binding InputLevel}" Foreground="{StaticResource Accent}" Background="#0B0F14" Margin="8,0,0,0"/>
                    <TextBlock Text="Gain Red." Grid.Row="1" Margin="0,10,0,0" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Row="1" Grid.Column="1" Height="12" Margin="8,10,0,0" Minimum="-24" Maximum="0"
                                 Value="{Binding GainReduction}" Foreground="{StaticResource Danger}" Background="#0B0F14"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="{Binding InputLevel, StringFormat='Input: {0:F1} dB'}" FontSize="11" Foreground="{StaticResource Accent}"/>
                    </Border>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10,6" Margin="8,0,0,0">
                        <TextBlock Text="{Binding GainReduction, StringFormat='GR: {0:F1} dB'}" FontSize="11" Foreground="{StaticResource Danger}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== STATUS ===== -->
        <Border Grid.Row="6" Background="#0D141B" CornerRadius="8" Padding="12,8" Margin="0,6,0,0" BorderBrush="#1E2B3A" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="10"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="FuryEqualize Pro" Foreground="#4A5864" FontSize="9"
                           HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
