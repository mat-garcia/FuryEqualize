<Window x:Class="FuryEqualize.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FuryEqualize" Height="600" Width="640" WindowStartupLocation="CenterScreen"
        Background="#101114" Foreground="#E8E8E8" ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E90FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,6,0,2"/><Setter Property="Foreground" Value="#B0B0B0"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="FURY" FontSize="28" FontWeight="Black" Foreground="#1E90FF"/>
            <TextBlock Text="EQUALIZE" FontSize="28" FontWeight="Light" Margin="6,0,0,0"/>
            <TextBlock Text="  •  Local  •  WASAPI Loopback" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#666"/>
        </StackPanel>

        <!-- Controles principais -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Captura (loopback)"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name"/>
                <TextBlock Text="Render (VB-Cable)"/>
                <ComboBox ItemsSource="{Binding RenderDevices}" SelectedItem="{Binding SelectedRenderDevice}" DisplayMemberPath="Name"/>
                <TextBlock Text="Buffer (latência)"/>
                <ComboBox ItemsSource="{Binding BufferSizes}" SelectedItem="{Binding SelectedBuffer}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding StartStopLabel}" Click="OnToggleEngine" Width="140"/>
                    <Button Content="↻ Atualizar" Click="OnRefresh" Background="#333" Width="100"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Preset"/>
                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"/>
                <Border Background="#1A1C20" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                    <TextBlock Text="{Binding SelectedPreset.Description}" TextWrapping="Wrap" Foreground="#888" FontSize="11"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Hotkeys: " Foreground="#666" FontSize="10"/>
                    <TextBlock Text="Ctrl+Alt+F1/F2/F3 troca preset" Foreground="#666" FontSize="10"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Meters -->
        <Border Grid.Row="2" Background="#181A1E" CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Telemetria (tempo real)" FontWeight="Bold" Foreground="#E8E8E8"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Input Level" Grid.Row="0" Grid.Column="0"/>
                    <ProgressBar Grid.Row="0" Grid.Column="1" Height="14" Minimum="-60" Maximum="0" Value="{Binding InputLevel}" Foreground="#1E90FF" Background="#2A2E36"/>
                    <TextBlock Text="Gain Reduction" Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"/>
                    <ProgressBar Grid.Row="1" Grid.Column="1" Height="14" Margin="0,8,0,0" Minimum="-24" Maximum="0" Value="{Binding GainReduction}" Foreground="#FF3B30" Background="#2A2E36"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding InputLevel, StringFormat='{}{0:F1} dB'}" FontSize="11" Foreground="#1E90FF" Width="110"/>
                    <TextBlock Text="{Binding GainReduction, StringFormat='{}{0:F1} dB GR'}" FontSize="11" Foreground="#FF3B30"/>
                </StackPanel>
                <TextBlock Text="Dica: desative 'Loudness Equalization' nas propriedades da placa física para não conflitar com a engine." 
                           Foreground="#555" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#0D0E10" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
            <DockPanel>
                <Ellipse Width="8" Height="8" Fill="{Binding IsRunning, Converter={x:Null}}" DockPanel.Dock="Left" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#555"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Fill" Value="#00C853"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" Foreground="#888" FontSize="11" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="FuryEqualize v0.1  •  C++20 + WPF" Foreground="#444" FontSize="10" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
