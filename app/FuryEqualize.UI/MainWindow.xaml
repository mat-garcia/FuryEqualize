<Window x:Class="FuryEqualize.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FuryEqualize — Sniper" Height="680" Width="720" WindowStartupLocation="CenterScreen"
        Background="#0A0C0F" Foreground="#E8E8E8" ResizeMode="CanMinimize">
    <Window.Resources>
        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E90FF" Offset="0"/><GradientStop Color="#7C4DFF" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E90FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A9DFF"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="Background" Value="#14181E"/><Setter Property="Foreground" Value="#E8E8E8"/></Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#1E90FF"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header premium -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16" Margin="0,0,0,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#14181E" Offset="0"/><GradientStop Color="#1A1F2E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource AccentGrad}" CornerRadius="10" Width="42" Height="42" VerticalAlignment="Center">
                        <TextBlock Text="◉" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FURY" FontSize="22" FontWeight="Black" Foreground="#1E90FF"/>
                            <TextBlock Text="EQUALIZE" FontSize="22" FontWeight="Light" Margin="6,0,0,0" Foreground="White"/>
                            <Border Background="#1E90FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SNIPER" FontSize="8" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Sniper Max Suppression  •  0.51ms  •  20:1  •  -24dB" FontSize="9" Foreground="#666"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="#1C2129" CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#555"/><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Fill" Value="#00E676"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StartStopLabel}" FontSize="11" Foreground="#E8E8E8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="WASAPI Loopback • VB-Cable" FontSize="8" Foreground="#444" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Master Volume destacado -->
        <Border Grid.Row="1" Background="#14181E" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#1E90FF" BorderThickness="1" Opacity="0.95">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MASTER" FontSize="10" Foreground="#1E90FF" FontWeight="Bold"/>
                    <TextBlock Text="{Binding MasterVolumeDb, StringFormat='{}{0:F1} dB'}" FontSize="18" FontWeight="Black" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <Slider Minimum="-24" Maximum="24" Value="{Binding MasterVolumeDb}" TickFrequency="3" IsSnapToTickEnabled="False" Height="18"/>
                    <Grid>
                        <TextBlock Text="-24dB" FontSize="8" Foreground="#555" HorizontalAlignment="Left"/>
                        <TextBlock Text="0dB" FontSize="8" Foreground="#555" HorizontalAlignment="Center"/>
                        <TextBlock Text="+24dB" FontSize="8" Foreground="#1E90FF" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource AccentGrad}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MasterVolumePercent, StringFormat='{}{0}%'}" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Controles -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Captura (loopback)" FontSize="10" Foreground="#888"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name"/>
                <TextBlock Text="Render (fone G435 / VB-Cable)" FontSize="10" Foreground="#888"/>
                <ComboBox ItemsSource="{Binding RenderDevices}" SelectedItem="{Binding SelectedRenderDevice}" DisplayMemberPath="Name"/>
                <TextBlock Text="Buffer (latência)" FontSize="10" Foreground="#888"/>
                <ComboBox ItemsSource="{Binding BufferSizes}" SelectedItem="{Binding SelectedBuffer}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{Binding StartStopLabel}" Click="OnToggleEngine" Width="150"/>
                    <Button Content="↻" Click="OnRefresh" Background="#1C2129" Width="42" ToolTip="Atualizar"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Preset" FontSize="10" Foreground="#888"/>
                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"/>
                <Border Background="#1C2129" CornerRadius="8" Padding="10" Margin="0,4,0,0" BorderBrush="#1E90FF" BorderThickness="1">
                    <TextBlock Text="{Binding SelectedPreset.Description}" TextWrapping="Wrap" Foreground="#AAA" FontSize="11"/>
                </Border>
                <TextBlock Text="Sniper Max Suppression: 0.51ms attack, 20:1, duck 24dB, step +5.98dB" FontSize="9" Foreground="#1E90FF" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="Hotkeys: Ctrl+Alt+F1 Flat • F2 Sniper" FontSize="8" Foreground="#555" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Meters -->
        <Border Grid.Row="3" Background="#14181E" CornerRadius="12" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Telemetria (tempo real)" FontWeight="Bold" FontSize="11" Foreground="#E8E8E8"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Input" Grid.Row="0" FontSize="10" Foreground="#888"/>
                    <ProgressBar Grid.Row="0" Grid.Column="1" Height="10" Minimum="-60" Maximum="0" Value="{Binding InputLevel}" Foreground="#1E90FF" Background="#0A0C0F"/>
                    <TextBlock Text="GR" Grid.Row="1" Margin="0,6,0,0" FontSize="10" Foreground="#888"/>
                    <ProgressBar Grid.Row="1" Grid.Column="1" Height="10" Margin="0,6,0,0" Minimum="-24" Maximum="0" Value="{Binding GainReduction}" Foreground="#FF3B30" Background="#0A0C0F"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding InputLevel, StringFormat='{}{0:F1} dB'}" FontSize="10" Foreground="#1E90FF" Width="90"/>
                    <TextBlock Text="{Binding GainReduction, StringFormat='{}{0:F1} dB GR'}" FontSize="10" Foreground="#FF3B30"/>
                    <TextBlock Text="  •  Master aumenta tudo" FontSize="9" Foreground="#555" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="4" Background="#0D0E10" CornerRadius="8" Padding="10,6" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="#888" FontSize="10" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Sniper v1 • JSON AppData/API" Foreground="#444" FontSize="8" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
